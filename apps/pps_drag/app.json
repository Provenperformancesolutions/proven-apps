{
 "id": "pps_drag",
 "title": "Proven Drag",
 "description": "BETA, still being tested on cars. Times 0-100 km/h, 60 ft, 1/8 mile and 1/4 mile from the car's own speed. For closed roads and track days only",
 "version": "1.0.2",
 "vendor": "Proven Performance Solutions",
 "loggingId": "PPD1",
 "iconGlyph": "flag",
 "mguHmi": [
  "ID7",
  "ID8"
 ],
 "requires": {
  "idrive7-renderd": "2.1.18",
  "mgu-inputgate": "1.1.0"
 },
 "signals": {
  "de.bmw.infotainment.vehicle.Vehicle2": {
   "statusCarSpeed2": "rs",
   "statusWheeltravel": "s",
   "statusWheeltravelRear": "s"
  },
  "de.bmw.infotainment.vehicle.CDS2": {
   "statusLongitudinalAccelerationMassCenter": "rs"
  },
  "de.bmw.powertrain.Powertrain": {
   "_optional": "the four wheel speeds: wheelspin is then an estimate, and the speed signal is not cross-checked at the launch",
   "ActualValueRPMWheel": "s"
  },
  "de.bmw.infotainment.SatellitePositioning": {
   "_optional": "the GPS receiver's own speed and height: the speed scale then comes from position legs, the height from the raw GPS value",
   "_broadcasts": [
    "updatePosition"
   ]
  },
  "de.bmw.infotainment.GPSData": {
   "_optional": "the raw GPS position and height: position legs then use the navigation's position, and there is no second source of height",
   "GPSPositionCAN": "s",
   "GPSPositionExtendedCAN": "s"
  },
  "de.bmw.infotainment.navigation.positioning.Positioning": {
   "_optional": "the navigation's position: position legs then need the raw GPS position",
   "_instances": "Main_Instance",
   "currentLocation": "s"
  },
  "de.bmw.chassis.VehicleModel": {
   "_optional": "the car's own road gradient on the Signals page (shown for study only, never used in a result)",
   "LaneSlope": "s"
  }
 },
 "screens": [
  {
   "name": "MAIN",
   "kind": "canvas",
   "title": "Proven Drag",
   "buttons": [
    [
     "BTN_ACTION",
     "Reset run"
    ],
    [
     "BTN_PAGE",
     "Next page"
    ],
    [
     "BTN_PREV",
     "Previous page"
    ],
    [
     "BTN_SETTINGS",
     "Settings"
    ]
   ]
  }
 ],
 "settings": [
  {
   "key": "speedUnit",
   "label": "Speed unit",
   "type": "choice",
   "default": "kmh",
   "options": [
    [
     "kmh",
     "km/h"
    ],
    [
     "mph",
     "mph"
    ]
   ]
  },
  {
   "key": "start",
   "label": "Clock starts",
   "type": "choice",
   "default": "slip",
   "options": [
    [
     "slip",
     "Slip: speed split from first movement, distances after 1 ft"
    ],
    [
     "standstill",
     "Everything from first movement"
    ],
    [
     "rollout",
     "Everything after the first foot"
    ]
   ]
  },
  {
   "key": "slopeLimit",
   "label": "Downhill start limit",
   "type": "choice",
   "default": "1",
   "options": [
    [
     "1",
     "1 %"
    ],
    [
     "2",
     "2 %"
    ],
    [
     "off",
     "Off"
    ]
   ]
  },
  {
   "key": "gps",
   "label": "GPS speed scale (off takes full effect after a restart)",
   "type": "bool",
   "default": false
  },
  {
   "key": "workshop",
   "label": "Workshop settings",
   "type": "bool",
   "default": false
  },
  {
   "key": "scale",
   "label": "Speed scale",
   "type": "choice",
   "default": "gps",
   "when": {
    "workshop": true
   },
   "options": [
    [
     "gps",
     "GPS factor (if one is learned)"
    ],
    [
     "off",
     "Off (1.000)"
    ],
    [
     "manual",
     "Manual"
    ]
   ]
  },
  {
   "key": "scaleManual",
   "label": "Manual speed scale (+: the car reads low)",
   "type": "number",
   "default": 0,
   "steps": [
    -400,
    -375,
    -350,
    -325,
    -300,
    -275,
    -250,
    -225,
    -200,
    -175,
    -150,
    -125,
    -100,
    -75,
    -50,
    -25,
    0,
    25,
    50,
    75,
    100,
    125,
    150,
    175,
    200,
    225,
    250,
    275,
    300,
    325,
    350,
    375,
    400
   ],
   "labels": {
    "-400": "-4.00 %",
    "-375": "-3.75 %",
    "-350": "-3.50 %",
    "-325": "-3.25 %",
    "-300": "-3.00 %",
    "-275": "-2.75 %",
    "-250": "-2.50 %",
    "-225": "-2.25 %",
    "-200": "-2.00 %",
    "-175": "-1.75 %",
    "-150": "-1.50 %",
    "-125": "-1.25 %",
    "-100": "-1.00 %",
    "-75": "-0.75 %",
    "-50": "-0.50 %",
    "-25": "-0.25 %",
    "0": "0.00 %",
    "25": "+0.25 %",
    "50": "+0.50 %",
    "75": "+0.75 %",
    "100": "+1.00 %",
    "125": "+1.25 %",
    "150": "+1.50 %",
    "175": "+1.75 %",
    "200": "+2.00 %",
    "225": "+2.25 %",
    "250": "+2.50 %",
    "275": "+2.75 %",
    "300": "+3.00 %",
    "325": "+3.25 %",
    "350": "+3.50 %",
    "375": "+3.75 %",
    "400": "+4.00 %"
   },
   "when": {
    "workshop": true,
    "scale": "manual"
   }
  },
  {
   "key": "askCar",
   "label": "Ask the car for values (study)",
   "type": "bool",
   "default": false,
   "when": {
    "workshop": true
   }
  },
  {
   "key": "xWheels",
   "label": "Wheel speeds, study (off takes full effect after a restart)",
   "type": "bool",
   "default": false,
   "when": {
    "workshop": true
   }
  },
  {
   "key": "xPos",
   "label": "Positions, study (off takes full effect after a restart)",
   "type": "bool",
   "default": false,
   "when": {
    "workshop": true
   }
  },
  {
   "key": "xStudy",
   "label": "Wheel travel, gradient, study (off takes full effect after a restart)",
   "type": "bool",
   "default": false,
   "when": {
    "workshop": true
   }
  },
  {
   "key": "xSignals",
   "label": "Note stop signals, study (while on, an app that hangs is not ended by one)",
   "type": "bool",
   "default": false,
   "when": {
    "workshop": true
   }
  },
  {
   "key": "theme",
   "label": "Colour theme",
   "type": "choice",
   "default": "proven",
   "options": [
    [
     "proven",
     "Proven"
    ],
    [
     "proven_red",
     "Proven Red"
    ],
    [
     "proven_blue",
     "Proven Blue"
    ],
    [
     "m_tricolour",
     "M Tricolour"
    ],
    [
     "m_red",
     "M Red"
    ],
    [
     "ice",
     "Ice White"
    ],
    [
     "amber",
     "Night Amber"
    ]
   ]
  },
  {
   "key": "layout",
   "label": "Screen layout",
   "type": "choice",
   "default": "full",
   "options": [
    [
     "full",
     "Full screen"
    ],
    [
     "standard",
     "Standard"
    ]
   ]
  },
  {
   "key": "renderer",
   "label": "Renderer",
   "type": "choice",
   "default": "auto",
   "options": [
    [
     "auto",
     "GPU 60 fps (default)"
    ],
    [
     "software",
     "Software"
    ]
   ]
  },
  {
   "key": "demo",
   "label": "Demo data",
   "type": "choice",
   "default": "off",
   "options": [
    [
     "auto",
     "Auto"
    ],
    [
     "on",
     "Always"
    ],
    [
     "off",
     "Never"
    ]
   ]
  }
 ],
 "config": {
  "comment": "raw -> value * factor + offset; \"invalid\" = the car's \"no value\". Speed and acceleration scaling as in the idrive7-apps kit. The rest is in the modules that read it (apps/pps_drag/gpsscale.js, wheels.js, slope.js). None of it has been measured by Proven.",
  "scaling": {
   "speed": {
    "factor": 0.015625,
    "offset": 0,
    "invalid": 65535,
    "unit": "km/h",
    "member": "speedVehicleCentreOfGravity"
   },
   "accel": {
    "factor": 0.002,
    "offset": -65,
    "invalid": 65535,
    "unit": "m/s2",
    "member": "longitudinalAccelerationCentreOfGravity"
   }
  }
 }
}